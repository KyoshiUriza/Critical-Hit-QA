# OS / cloud-sync artifacts
# This project lives in a Google Drive synced folder. Drive stages uploads —
# including compressed .git objects — in .tmp.driveupload/, which churns
# constantly and must never be committed.
.tmp.driveupload/
desktop.ini
*.gdoc
*.gsheet
*.gslides

.DS_Store
.DS_Store?
Thumbs.db

# Editors
.vscode/
.idea/
*.swp

# Node / tooling
node_modules/
npm-debug.log*
# package-lock.json is committed on purpose: `npm ci` in CI requires it.

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Secrets — never commit
.env
.env.*
*.pem
*.key
credentials.json

# Deploy platform caches
.netlify/
.vercel/
coverage/

# Regenerable design reference shots (node capture-design-audit.js)
/design-audit/

# Full page-by-page screenshot set (node capture-screenshots.js).
# 144 images, ~27 MB — against a 1.7 MB repo. Committing them would grow the
# history 17x to store files that are stale the moment a style changes and
# that regenerate in under a minute. The generator is the durable artifact;
# the images are its output.
/screenshots/
